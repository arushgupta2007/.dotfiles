# Nix build symlinks
result
result-*

# Secret material — never committed. Each machine that needs to decrypt
# a secret must run `cd secrets && agenix -e <name>.age` to provision it
# locally. The plaintext never enters Git; only the rules in
# secrets/secrets.nix are version-controlled.
*.age
!secrets/*.age.example

# Local shell / editor scratch
*.swp
.DS_Store

# Python
__pycache__
*.pyc
.venv/

# Node
node_modules/

# Editor caches
.cache/
.fleet/
.idea/
.vscode/

# direnv - real .envrc files (the .example templates are checked in)
.envrc

# Build directories
build/
dist/
target/
